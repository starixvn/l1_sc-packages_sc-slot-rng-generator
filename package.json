{
    "name": "sc-slot-rng-generator",
    "version": "1.0.1",
    "description": "Slot RNG Generator",
    "main": "./lib/index.js",
    "typings": "./lib/index.d.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "reg": "npm set registry http://npm.lumigame.com",
        "pub": "tsc && npm publish --registry http://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "tsc && npm publish --registry http://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "files": [
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-slot-rng-generator.git"
    },
    "keywords": [
        "board-generator",
        "sc-slot-rng-generator"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "ISC",
    "dependencies": {
        "chance": "^1.1.7",
        "ramda": "^0.28.0",
        "random": "^3.0.6",
        "random-js": "^2.1.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@types/chance": "^1.1.3",
        "@types/jest": "^27.0.0",
        "@types/ramda": "^0.28.12",
        "babel-jest": "^27.0.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^27.0.0",
        "jest-extended": "^0.11.5",
        "jest-micro-auto-stub": "^1.0.7",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^3.0.2",
        "sc-semantic-release": "^1.2.0",
        "semantic-release": "^17.1.1",
        "ts-jest": "^27.1.4",
        "typescript": "^4.6.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
